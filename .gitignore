# ── Virtual environment ────────────────────────────────────────
# Contains thousands of installed packages — never commit these.
# Anyone cloning the repo runs `python -m venv venv` to recreate it.
venv/
.venv/

# ── Environment variables ──────────────────────────────────────
# .env contains real passwords. NEVER commit this file.
# .env.example has no real values — safe to commit as documentation.
.env
*.env

# ── Python compiled files ─────────────────────────────────────
# Auto-generated by Python when running code — not source code.
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/

# ── Testing and analysis cache ────────────────────────────────
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ── IDE workspace files ───────────────────────────────────────
.vscode/
.idea/

# ── OS generated files ────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── MLflow / DVC (phases 3–4) ─────────────────────────────────
# Declared now to prevent accidental commits later.
mlruns/
.dvc/tmp/
*.dvc

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/chroma_data/ 
chroma_data/ 


!.dvc
/test_clean.pdf
mlruns.db 
