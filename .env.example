# ================================================================
# OmniDoc — Environment Variables Reference
# ================================================================
# SAFE TO COMMIT — contains no real values, only placeholders.
#
# HOW TO USE:
#   1. copy .env.example .env
#   2. Open .env and replace every placeholder with a real value
#   3. Never commit .env — it is listed in .gitignore
#
# RULE: Every variable must have a comment explaining what it does.
# RULE: Never hardcode any of these values in source code.
# ================================================================


# ── PostgreSQL ──────────────────────────────────────────────────
# Primary relational database — source of truth for all metadata.
# Stores: users, tenants, documents, query cost logs, audit trails.
# Why PostgreSQL: supports row-level security (RLS) which enforces
# tenant isolation at DB layer — not just API filtering.

POSTGRES_USER=omnidoc_user
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=omnidoc_db

# CRITICAL: Inside Docker, services talk by service name NOT localhost.
# Use POSTGRES_HOST=postgresql inside Docker (service name in compose).
# Use POSTGRES_HOST=localhost only from outside Docker (e.g. DBeaver GUI).
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432


# ── MongoDB ─────────────────────────────────────────────────────
# Quarantine store for PII-flagged documents.
# Why MongoDB not PostgreSQL: quarantined docs are schema-less —
# we don't know their structure until inspected. Mongo handles
# arbitrary shapes better than forcing into a fixed schema.

MONGO_ROOT_USER=omnidoc_mongo
MONGO_ROOT_PASSWORD=replace_with_strong_password
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=omnidoc_quarantine


# ── Redis ────────────────────────────────────────────────────────
# Two roles:
#   Phase 2 — Celery task broker for async ingestion jobs
#   Phase 5 — Redis Streams internal event bus for state changes
# Why Redis for both: already in stack for Celery, adding Kafka
# for events would add infra complexity with no benefit at our scale.

REDIS_PASSWORD=replace_with_strong_password
REDIS_HOST=redis
REDIS_PORT=6379


# ── MinIO ────────────────────────────────────────────────────────
# S3-compatible object storage for all raw uploaded files.
# Why MinIO not local filesystem: gives us S3 API so code is
# identical whether files live locally or in real AWS S3 in production.
#
# WARNING: MINIO_ROOT_PASSWORD must be minimum 8 characters.
# MinIO silently refuses to start if shorter — no error shown.

MINIO_ROOT_USER=omnidoc_minio
MINIO_ROOT_PASSWORD=atleast8chars
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_DOCUMENTS=documents


# ── FastAPI ──────────────────────────────────────────────────────
# Main API gateway — all client requests enter here.
# Handles: JWT auth, RBAC checks, tenant_id injection, routing.

API_HOST=0.0.0.0
API_PORT=8000

# SECRET_KEY signs JWT tokens. If this leaks anyone can forge auth.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_and_replace_never_use_this_value

# HS256 = HMAC-SHA256, standard for single-server JWT signing.
ALGORITHM=HS256

# How long login sessions stay valid before user must re-authenticate.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Notifications ────────────────────────────────────────────────
# SMTP settings for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=noreply@omnidoc.ai

# Slack webhook URL for document notifications
# Create at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Whether notifications are enabled (true/false)
NOTIFICATIONS_ENABLED=false