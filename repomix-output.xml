<file path="services/api/app/parsers/word_parser.py">
# ================================================================
# services/api/app/parsers/word_parser.py
# ================================================================
# Extracts text from Microsoft Word documents (.docx, .doc).
#
# WHY python-docx:
# Word files are ZIP containers with XML. python-docx handles
# all the complexity — we just iterate paragraphs and tables.
# Extracts text while preserving document structure (paragraphs,
# tables, lists).
# ================================================================

from docx import Document
from io import BytesIO
from dataclasses import dataclass


@dataclass
class ParsedWord:
    text: str
    pages: list[str]
    parser_used: str = "python-docx"


def parse_word_document(file_content: bytes) -> ParsedWord:
    """
    Extracts text from a Word document (.docx or .doc).

    Handles:
    - Paragraph text
    - Table content
    - Heading hierarchy
    - Lists

    Args:
        file_content: raw bytes of the .docx file

    Returns:
        ParsedWord with full text and page list
    """
    try:
        # Load document from bytes
        doc = Document(BytesIO(file_content))
    except Exception as e:
        raise ValueError(f"Failed to parse Word document: {str(e)}")

    # Extract text from paragraphs
    paragraphs = []
    for para in doc.paragraphs:
        text = para.text.strip()
        if text:
            paragraphs.append(text)

    # Extract text from tables
    for table in doc.tables:
        for row in table.rows:
            row_cells = [cell.text.strip() for cell in row.cells]
            row_text = " | ".join(row_cells)
            if row_text.strip():
                paragraphs.append(row_text)

    # Combine all text
    full_text = "\n\n".join(paragraphs)

    if not full_text.strip():
        raise ValueError("No extractable text found in Word document")

    # Word documents don't have pages — treat as single page
    pages = [full_text]

    return ParsedWord(
        text=full_text,
        pages=pages,
        parser_used="python-docx",
    )
</file>

